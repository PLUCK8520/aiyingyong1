# ---- 助手工作记忆（项目内部数据，不入公开仓库）----
.workbuddy/

# ---- 环境 / 密钥 ----
.env
.env.*
!.env.example
.venv/
venv/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ---- 项目数据（本地缓存 / 索引 / 检查点，不入库）----
data/cache/
data/index/
data/chroma_smoke/
*.db
*.sqlite
*.sqlite3
# SQLite WAL / 共享内存副产物（P6 起检查点常驻写，会稳定产生这两个文件）
*.sqlite-shm
*.sqlite-wal
chroma/
chroma_db/

# ---- 知识库上传目录（T8.1）----
# ⚠️ 上传的文档与仓库自带的示例语料**同目录**（`local_docs_dir` 默认指向 fixtures/local）。
# 只放行 `local_*.md` 这 7 个示例，其余一律不跟踪：否则用户上传的私密资料
# 会在下一次 `git add -A` 时被提交并推到 GitHub —— 这是功能自身引入的泄露通道。
data/fixtures/local/*
!data/fixtures/local/local_*.md

# ---- Trace / 评测产物（每次运行都会变，不入库）----
trace.jsonl
*.jsonl.tmp
data/trace/
data/reports/
data/cache/
eval/reports/

# ---- 前端 ----
node_modules/
frontend/dist/
.vite/

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# 提交信息临时文件（曾误提交过一次：data/commit-msg.txt）
data/commit-msg.txt
# 环境变量备份（含本机 PATH，别进仓库）
data/path-backup-*.txt
