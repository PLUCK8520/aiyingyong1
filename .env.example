# Attest（质证）· 环境变量样例
# 复制为 .env 后填写：cp .env.example .env
# 全部变量都有默认值——**不填任何东西也能跑通离线链路**（mock LLM + fixture 检索）。

# ================= 模式开关 =================
# mock（默认，不花钱）/ dashscope（真实模型）/ ollama（本地，断网兜底）
ATTEST_LLM_MODE=mock
# mock（默认，离线 fixture）/ tavily（真实检索，消耗 credits）
ATTEST_SEARCH_MODE=mock

# ================= 密钥 =================
# 阿里云百炼：https://bailian.console.aliyun.com
# ⚠️ 免费额度【仅支持华北2(北京)地域】实时推理调用；额度每模型 100 万 token / 90 天，不跨模型合并。
# ⚠️ 请在控制台开启「用完即停」，否则超额自动扣费。
DASHSCOPE_API_KEY=
# Tavily：https://tavily.com （免费 1000 credits/月，basic 1 credit/次）
# ⚠️ 开发调试请走离线 fixture；只有录 fixture 与验收才打真实 API。
TAVILY_API_KEY=

# ================= 端点 =================
# ⚠️ 必须锁华北2(北京)，配成 intl 域名会静默按量扣费（启动即校验）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# ================= 模型映射（任务类型 → 模型）=================
ATTEST_MODEL_INTENT=qwen3.7-flash
ATTEST_MODEL_DIRECT=qwen3.8-flash
ATTEST_MODEL_PLANNER=qwen3.8-max
ATTEST_MODEL_JUDGE=qwen3.7-flash
ATTEST_MODEL_ANALYST=qwen3.8-max
ATTEST_MODEL_AUDIT_FAST=qwen3.7-flash
ATTEST_MODEL_AUDIT_STRONG=qwen3.8-max
ATTEST_MODEL_EMBED=text-embedding-v4

# ================= 预算（派生式，ADR-02）=================
# 熔断只降级不杀进程：不变式是「报告必须产出」
ATTEST_BUDGET_CNY=2.0
ATTEST_BUDGET_TOKENS=300000
ATTEST_FUSE_WARN=0.70
ATTEST_FUSE_HARD=0.90

# ================= 运行参数 =================
ATTEST_LOG_LEVEL=INFO
ATTEST_CTX_TRUNCATE=4000
ATTEST_SEARCH_CONCURRENCY=3
ATTEST_MAX_REFLECT_ROUNDS=2
