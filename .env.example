# Attest（质证）· 环境变量样例
# 复制为 .env 后填写：cp .env.example .env
# 全部变量都有默认值——**不填任何东西也能跑通离线链路**（mock LLM + fixture 检索）。

# ================= 模式开关 =================
# mock（默认，不花钱）/ dashscope（阿里百炼）/ siliconflow（硅基流动）/ ollama（本地，断网兜底）
ATTEST_LLM_MODE=mock
# mock（默认，离线 fixture）/ tavily（真实检索，消耗 credits）
ATTEST_SEARCH_MODE=mock

# ================= 密钥 =================
# ⚠️ 不同平台的 key **不通用**：把硅基流动的 key 填进 DASHSCOPE_API_KEY，百炼回
#    401「Incorrect API key」——看着像 key 坏了，其实是走错门（2026-09-12 真实踩过）。
#     不确定手里的 key 属于哪家：.venv/Scripts/python.exe scripts/probe_which_vendor.py
#
# 阿里云百炼：https://bailian.console.aliyun.com
# ⚠️ 免费额度【仅支持华北2(北京)地域】实时推理调用；额度每模型 100 万 token / 90 天，不跨模型合并。
# ⚠️ 请在控制台开启「用完即停」，否则超额自动扣费。
DASHSCOPE_API_KEY=
# 硅基流动：https://cloud.siliconflow.cn
# ⚠️ 需**实名认证**才能拿到赠金；未认证/无余额时**所有模型**（含标"免费"的）一律 402
#    「account balance is insufficient」——免费模型也受账户状态门禁。
# 价格（①一手 siliconflow.cn/pricing）：Qwen3.5-35B-A3B ¥0.4/¥3.2；DeepSeek-V4-Flash ¥3/¥9（分时段，2-8 点减半）
# 免费：BAAI/bge-m3（embedding）、BAAI/bge-reranker-v2-m3（rerank）
SILICONFLOW_API_KEY=
# Tavily：https://tavily.com （免费 1000 credits/月，basic 1 credit/次；学生可申请 4 个月 Project）
# ⚠️ 开发调试请走离线 fixture；只有录 fixture 与验收才打真实 API。
TAVILY_API_KEY=

# ================= 端点 =================
# ⚠️ 必须锁华北2(北京)，配成 intl 域名会静默按量扣费（启动即校验）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# 通用 OpenAI 兼容档（ATTEST_LLM_MODE=openai_compat）：任何兼容厂商/中转站都能接，
# 只认 base_url + key —— 加这一档是因为换一家厂商就要改一次代码，那是设计缺陷。
# ⚠️ 中转/聚合站的 key **只在它自己的域名有效**，官方域名一律 401「Invalid Authentication」；
#    base_url 必须含 /v1（漏了是最常见的 404 成因）。
# ⚠️ 不是每家都提供 embedding：Kimi/Moonshot 只有对话模型，没有 embedding/rerank 接口。
#    缺 embedding 时**默认本地知识库会整个禁用**（web 检索与成文照常），日志里会说明原因。
#    如果希望"没有真 embedding 也要能检索本地资料"，把下面这项设为 hashing（详见「知识库」节）。
ATTEST_COMPAT_BASE_URL=
ATTEST_COMPAT_API_KEY=
# 只进日志与 trace 的可读标签（如 kimi / 中转站A / zhipu-glm），不参与任何逻辑
ATTEST_COMPAT_LABEL=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# ================= 模型映射（任务类型 → 模型）=================
# 每个模型各有独立免费额度（每模型 100 万 token / 90 天），所以分档用**不冲突**：
# 重活（规划/成文）用 max，轻活（意图/判别/矛盾/审计初筛）用 flash。
ATTEST_MODEL_INTENT=qwen3.7-flash
ATTEST_MODEL_DIRECT=qwen3.8-flash
ATTEST_MODEL_PLANNER=qwen3.8-max
ATTEST_MODEL_JUDGE=qwen3.7-flash
ATTEST_MODEL_CONFLICT=qwen3.7-flash
ATTEST_MODEL_ANALYST=qwen3.8-max
ATTEST_MODEL_AUDIT_FAST=qwen3.7-flash
ATTEST_MODEL_AUDIT_STRONG=qwen3.8-max
ATTEST_MODEL_EMBED=text-embedding-v4
# 精排模型（硅基流动的 bge-reranker-v2-m3 官方标免费；此前真实档只有从未实跑的百炼 rerank）
ATTEST_MODEL_RERANK=BAAI/bge-reranker-v2-m3
# 熔断 L1 降级目标（额度紧张时轻任务切这里）
ATTEST_MODEL_FUSE_LIGHT=qwen3.7-flash

# ================= T7.4 研究闭环 =================
# 第二次跑同类问题时会检索上一次沉淀的研究结论（只收审计判 supported 的）
ATTEST_RESEARCH_MEMORY_ENABLED=1

# ================= 预算（派生式，ADR-02）=================
# 熔断只降级不杀进程：不变式是「报告必须产出」
ATTEST_BUDGET_CNY=2.0
ATTEST_BUDGET_TOKENS=300000
ATTEST_FUSE_WARN=0.70
ATTEST_FUSE_HARD=0.90
# L2 硬熔断时正文证据按相关性截断到 top-k（只影响"这次送多少进上下文"，不影响可回查的全量索引）
ATTEST_FUSE_CTX_TOP_K=6

# ================= 运行参数 =================
ATTEST_LOG_LEVEL=INFO
ATTEST_CTX_TRUNCATE=4000
ATTEST_SEARCH_CONCURRENCY=3
ATTEST_MAX_REFLECT_ROUNDS=2
# T9.1 analyst 结构化输出协议（默认开）：模型分章输出并在 <<CITE>> 行声明本章依据的
#    证据编号，由代码确定性拼装进正文（章末依据行）——编号不再依赖弱模型"句末挂编号"
#    的服从性（2026-09-13/14 实测 glm-4-flash 免费档四次整篇零编号，审计网整体失效）。
#    模型不服从格式时自动降级回纯文本路径；置 0 则完全回到 P8 及以前的行为（对照用）。
ATTEST_ANALYST_STRUCTURED=1
# 单次 LLM 调用的读超时（秒）。⚠️ 实测教训：证据判别要一次送 20+ 条证据，免费档 60s 回不来
#    → 三次超时把整轮拖垮。用真实模型时建议给足余量（默认 120）。
ATTEST_LLM_TIMEOUT=120

# ================= 人工介入 =================
# 打开大纲确认（Planner 出大纲后暂停，可修改 / 跳过；任意断点可恢复续跑）
ATTEST_HUMAN_CONFIRM=0

# ================= 本地知识库（P8：Web 端可上传 / 移除）=================
# 关闭后：上传照样落盘，但**检索不召回**（传了也白传）
ATTEST_LOCAL_ENABLED=1
# numpy（默认，索引不持久化，改文档只需失效缓存）/ chroma（持久化，上传与删除必须同步索引）
ATTEST_LOCAL_STORE=numpy
# 文档目录。⚠️ 默认与仓库自带示例语料同目录，已在 .gitignore 里白名单化（只放行 local_*.md），
#    改成别的目录请自行确认它也在忽略范围内——否则你上传的资料会被提交进仓库。
ATTEST_LOCAL_DOCS=data/fixtures/local
ATTEST_CHUNK_CHARS=800
ATTEST_CHUNK_OVERLAP=120
# 持久化索引位置（仅 local_store=chroma 时使用）
ATTEST_CHROMA_DIR=data/index/chroma
# embedding 兜底：none（默认，如实失败：装配失败即禁用本地检索，日志说明原因）
#              / hashing（退回离线散列向量 256 维，保住本地检索与研究闭环，但语义质量弱于真向量）
ATTEST_EMBED_FALLBACK=none
# 精排候选数（进 rerank 的条数上限）
ATTEST_RERANK_CANDIDATES=20

# ================= 引用审计（T4.1/T4.2）=================
ATTEST_AUDIT_ENABLED=1
# 某章节 unsupported 占比 > 阈值 → 用证据只重写这一节；重写后仍不达标则逐句标注「（未证实）」
ATTEST_AUDIT_REWRITE_RATIO=0.5
ATTEST_AUDIT_MAX_REWRITES=1

# ================= 矛盾检测（T3.x）=================
# 聚类阈值（越小越容易把不同说法归到同一话题）
ATTEST_CONFLICT_THRESHOLD=0.25
# 数值差异倍数下限（低于此倍数不算冲突）
ATTEST_CONFLICT_MIN_RATIO=1.5
ATTEST_CONFLICT_PAIRS_CLUSTER=6
ATTEST_CONFLICT_PAIRS_GLOBAL=30

# ================= 存储与产物路径（默认都在 data/ 下，一般不用改）=================
ATTEST_CHECKPOINT_ENABLED=1
ATTEST_CHECKPOINT_DB=data/checkpoints.sqlite
ATTEST_PROFILE_ENABLED=1
ATTEST_PROFILE_DB=data/profile.sqlite
ATTEST_TRACE_DIR=data/trace
ATTEST_REPORT_DIR=data/reports
ATTEST_FIXTURE_DIR=data/fixtures
ATTEST_RESEARCH_MEMORY_DIR=data/index/research_memory
ATTEST_RESEARCH_MEMORY_TOP_K=3
